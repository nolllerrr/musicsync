<Window x:Class="PatchWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicSync" Width="490" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Loaded="CheckUpdatesOnLoad"
        Icon="Assets/Together.ico"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/YandexDark.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.ThemeMode>Dark</Window.ThemeMode>

    <StackPanel Margin="20">
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="Assets/Together.png"
                       Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="MusicSync" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Раздел «Вместе» в Яндекс Музыке" Foreground="{StaticResource Muted}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <StackPanel x:Name="Controls">
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Content="Установить патч" Style="{StaticResource Primary}" Click="Install_Click"/>
                <Button Grid.Column="2" Content="Удалить патч" Click="Uninstall_Click"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14">
                <StackPanel>
                    <TextBlock Text="Настройки подключения" FontSize="16" FontWeight="SemiBold"/>
                    <Label x:Name="EndpointLabel" Content="Адрес сервера WebSocket" Target="{Binding ElementName=Endpoint}"
                           Padding="0,8,0,5"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Сохранить" Click="Save_Click" Margin="8,0,0,0"/>
                        <TextBox x:Name="Endpoint" MaxLength="2048" SpellCheck.IsEnabled="False"
                                 AutomationProperties.LabeledBy="{Binding ElementName=EndpointLabel}"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="2,0,10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"
                       Text="Если Яндекс Музыка открыта, MusicSync перезапустит её после установки или удаления патча."/>
            <Grid Grid.Column="1" VerticalAlignment="Bottom">
                <Button x:Name="UpdateButton" Width="36" Height="36" Padding="0" Click="CheckUpdates_Click"
                        ToolTip="Проверить обновления" AutomationProperties.Name="Проверить обновления">
                    <Path Width="19" Height="19" Stretch="Uniform" StrokeThickness="2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="M 21,8 A 9,9 0 0 0 5,6 L 3,9 M 3,3 L 3,9 L 9,9
                                M 3,16 A 9,9 0 0 0 19,18 L 21,15 M 15,15 L 21,15 L 21,21"/>
                </Button>
                <Ellipse x:Name="UpdateBadge" Width="8" Height="8" HorizontalAlignment="Right"
                         VerticalAlignment="Top" Fill="{StaticResource Accent}" IsHitTestVisible="False"
                         Visibility="Collapsed" Margin="0,-2,-2,0"/>
            </Grid>
        </Grid>
    </StackPanel>
</Window>
