<Window x:Class="MusicSync.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicSync" Width="740" Height="700" MinWidth="640" MinHeight="530"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="#F2F5FA" Foreground="#17253A" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#3148C7"/>
        <SolidColorBrush x:Key="Muted" Color="#53647B"/>
        <SolidColorBrush x:Key="Line" Color="#D8E0ED"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#213456"/>
            <Setter Property="Background" Value="#EDF2FB"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#5772DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#A4B3CA"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22" MaxWidth="840">
            <Border Background="#182745" CornerRadius="13" Padding="18" Margin="0,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="#3148C7" CornerRadius="10"
                            Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,13,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Rectangle Width="4" Height="12" Fill="White" RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="4" Height="23" Fill="White" RadiusX="2" RadiusY="2" Margin="4,0"/>
                            <Rectangle Width="4" Height="17" Fill="White" RadiusX="2" RadiusY="2"/>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Right" Background="#2B3D61" CornerRadius="12" Padding="10,4"
                            VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="ModeLabel" Foreground="#F0F4FF" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="MusicSync" FontSize="27" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Text="Слушайте Яндекс Музыку вместе" Foreground="#D0DBF5" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel x:Name="Lobby">
                <TextBlock Text="Комнаты" Style="{StaticResource Heading}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <Button x:Name="CreateButton" Content="Создать комнату" Style="{StaticResource Primary}"
                                    Click="Create_Click" DockPanel.Dock="Bottom" HorizontalAlignment="Left"/>
                            <StackPanel>
                                <TextBlock Text="Новая комната" Style="{StaticResource Heading}"/>
                                <TextBlock Text="Вы будете ведущим. Код для приглашения скопируется автоматически."
                                           Style="{StaticResource Caption}" Margin="0,5,0,14"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Войти по коду" Style="{StaticResource Heading}"/>
                            <Label Content="_Код комнаты" Target="{Binding ElementName=Invitation}" Padding="0,5,0,4"/>
                            <TextBox x:Name="Invitation" MaxLength="64" FontFamily="Consolas"/>
                            <Button x:Name="JoinButton" Content="Подключиться" Click="Join_Click" IsDefault="True"
                                    HorizontalAlignment="Left" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Button x:Name="CancelConnection" Content="Отменить подключение" Click="Leave_Click"
                        HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <StackPanel x:Name="RoomPanel" Visibility="Collapsed">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Копировать код" Click="Copy_Click" Margin="0,0,8,0"/>
                                <Button Content="Выйти" Click="Leave_Click"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Код комнаты" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="RoomCode" FontFamily="Consolas" FontSize="18" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="RoleStatus" FontWeight="SemiBold" Margin="0,10,0,3" TextWrapping="Wrap"/>
                        <TextBlock x:Name="PeerStatus" Style="{StaticResource Caption}"/>
                        <Button x:Name="SwapRolesButton" Content="Сменить роли" Click="SwapRoles_Click"
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                        <TextBlock x:Name="SwapStatus" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Сейчас в плеере" Style="{StaticResource Caption}"/>
                        <TextBlock x:Name="Song" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock x:Name="Artist" Style="{StaticResource Caption}"/>
                        <ProgressBar x:Name="PlaybackProgress" Maximum="1" Height="5" Margin="0,10,0,0"
                                     Foreground="{StaticResource Accent}" AutomationProperties.Name="Позиция воспроизведения"/>
                        <TextBlock x:Name="Timeline" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        <Expander x:Name="LeaderControls" Header="Управление воспроизведением" Margin="0,12,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <Label Content="Ссылка на трек Яндекс Музыки" Target="{Binding ElementName=TrackUrl}" Padding="0,0,0,4"/>
                                <DockPanel>
                                    <Button Content="Воспроизвести" DockPanel.Dock="Right" Click="Select_Click" Margin="8,0,0,0"/>
                                    <TextBox x:Name="TrackUrl" MaxLength="2048"/>
                                </DockPanel>
                                <WrapPanel Margin="0,9,0,0">
                                    <Button x:Name="PauseButton" Content="Пауза" Click="Pause_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="PlayButton" Content="Продолжить" Click="Play_Click" Margin="0,0,12,0"/>
                                    <TextBox x:Name="SeekPosition" Width="78" MaxLength="10" Margin="0,0,8,0"
                                             AutomationProperties.Name="Позиция перемотки в минутах и секундах" ToolTip="Например 1:30"/>
                                    <Button x:Name="SeekButton" Content="Перемотать" Click="Seek_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Background="#FFF4E4" BorderBrush="#F0D8B4" BorderThickness="1" CornerRadius="8"
                    Padding="12,8" Margin="0,12,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Notice}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock x:Name="Notice" TextWrapping="Wrap" Foreground="#743718"/>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Сервер" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ServerStatus" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Яндекс Музыка" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PlayerStatus" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Expander x:Name="NetworkOptions" Header="Настройки подключения" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <Label Content="Адрес сервера" Target="{Binding ElementName=Endpoint}" Padding="0,0,0,4"/>
                            <TextBox x:Name="Endpoint"/>
                            <CheckBox x:Name="AllowLan" Content="Разрешить ws:// для доверенной локальной сети" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Expander>
                    <StackPanel x:Name="SyncPanel" Visibility="Collapsed">
                        <Border Height="1" Background="{StaticResource Line}" Margin="0,12,0,10"/>
                        <TextBlock x:Name="SyncStatus" TextWrapping="Wrap"/>
                        <Button x:Name="RetryButton" Content="Повторить синхронизацию" Click="Retry_Click"
                                Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        <Expander Header="Диагностика синхронизации" Margin="0,9,0,0">
                            <StackPanel Margin="0,7,0,0">
                                <TextBlock x:Name="RevisionStatus" Style="{StaticResource Caption}"/>
                                <TextBlock x:Name="DifferenceStatus" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Content="Открыть журнал диагностики" Click="Logs_Click"
                        Background="White" Margin="12,0,0,0"/>
                <TextBlock Text="При закрытии окна MusicSync остаётся в трее."
                           Style="{StaticResource Caption}" VerticalAlignment="Center"/>
            </DockPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
